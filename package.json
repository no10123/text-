{
  "name": "text-",
  "displayName": "text+",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["*"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "ANSI previewer",
      "properties": {
        "stringPreview.themePreset": {
          "type": "string",
          "default": "catppuccin-mocha",
          "enum": [
            "dracula",
            "nord",
            "gruvbox",
            "catppuccin-mocha",
            "none",
            "custom"
          ],
          "description": "Select a prebuilt ANSI color theme, or make your own with 'custom'\n(none is the default ansi colors.)."
        },
        "stringPreview.ansiColors": {
          "type": "array",
          "default": [
            "#21222C", "#FF5555", "#50FA7B", "#F1FA8C", 
            "#BD93F9", "#FF79C6", "#8BE9FD", "#F8F8F2"
          ],
          "description": "Custom ANSI color palette (set theme preset to 'custom' to use these.)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
