{
  "name": "text-",
  "displayName": "text+",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["*"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "ANSI Previewer",
      "properties": {
        "stringPreview.ansiColors": {
          "type": "array",
          "default": [
            "#000000", "#cd0000", "#00cd00", "#cdcd00", 
            "#0000ee", "#cd00cd", "#00cdcd", "#e5e5e5"
          ],
          "description": "custom definitions for the 8 standard ANSI colors (Black, Red, Green, Yellow, Blue, Magenta, Cyan, White)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
